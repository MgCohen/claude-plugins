{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "view.json",
  "description": "How the UI shows a message of one kind: the full document and the preview (the card and the stream row). Each \"as\" must be a look of looks.json, in a place that the look allows. Each field must be a property of schema.json.",
  "type": "object",
  "required": ["label", "icon", "tone", "document", "preview"],
  "properties": {
    "label": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "description": "A name of the icon set of the UI (Ui.Icons)." },
    "tone": { "$ref": "#/$defs/tone" },
    "toneBy": {
      "type": "object",
      "description": "A field whose value changes the tone and the icon.",
      "required": ["field", "values"],
      "properties": {
        "field": { "type": "string" },
        "values": { "type": "object", "additionalProperties": { "$ref": "#/$defs/tone" } },
        "icons": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "description": "Optional: the content actions of the document page (the corner button). The id is the contract with the app code, which maps it to a behavior. At most one main action. Danger actions show last, in red, and ask to confirm.",
      "items": {
        "type": "object",
        "required": ["id", "label", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "role": { "enum": ["main", "other", "danger"] }
        },
        "additionalProperties": false
      }
    },
    "document": {
      "type": "object",
      "required": ["title", "facts", "blocks"],
      "properties": {
        "title": { "$ref": "#/$defs/texts" },
        "subtitle": { "$ref": "#/$defs/texts" },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      },
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/texts" },
        "line": { "$ref": "#/$defs/texts" },
        "well": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "chips": { "$ref": "#/$defs/field" },
        "list": { "$ref": "#/$defs/field" },
        "pill": { "$ref": "#/$defs/field" },
        "progress": { "type": "string", "description": "The field with the percent done." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tone": { "enum": ["new", "accent", "done", "pending", "failed", "muted"] },
    "texts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Fallback templates: the first one whose fields all have a value. {{field}} is a field, {{#field}}…{{/field}} is a section, {{render:field}} is the first line of the render that the field names."
    },
    "field": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "render": { "type": "string", "description": "A field whose value names a render file. The block shows that render." },
        "label": { "type": "string" },
        "as": { "type": "string", "description": "A look of looks.json. Default: text." },
        "mark": { "type": "string", "description": "A field whose value is marked in the chips." },
        "tones": { "type": "object", "additionalProperties": { "$ref": "#/$defs/tone" } },
        "tone": { "$ref": "#/$defs/tone" },
        "max": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [{ "required": ["field"] }, { "required": ["render"] }],
      "additionalProperties": false
    }
  }
}
