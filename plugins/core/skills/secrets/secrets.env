# Environment variable = 1Password secret reference. References only, never values.
# Vault "agent": one item for each secret. The item title is the variable name. The field is "credential".

# inbox Worker (MgCohen/inbox): bearer token for /api/* and /listen
INBOX_TOKEN=op://agent/INBOX_TOKEN/credential

# Notion connection "Claude workflow": internal API token. notion-context reads NOTION_TOKEN.
# The item title is NOTION_API_TOKEN, because the runner repo also uses that item.
NOTION_TOKEN=op://agent/NOTION_API_TOKEN/credential

# GitHub token of the gh CLI (scope read:packages and more). NuGet restore of the VSA feed (GitHub Packages) reads GITHUB_TOKEN.
GITHUB_TOKEN=op://agent/GITHUB_TOKEN/credential
